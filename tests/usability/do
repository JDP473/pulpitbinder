#!/bin/bash
# do PORT command [args...] : one action in the tester's browser
port=$1; cmd=$2; shift 2
python3 - "$port" "$cmd" "$@" <<'PY'
import sys, json, urllib.request
port, cmd, args = sys.argv[1], sys.argv[2], sys.argv[3:]
r = urllib.request.Request(f"http://127.0.0.1:{port}/", data=json.dumps({"cmd": cmd, "args": args}).encode(), method="POST")
print(urllib.request.urlopen(r, timeout=90).read().decode())
PY
